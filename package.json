{
  "name": "nsr-impulse",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:backend": "npm --workspace apps/backend run dev",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "db:generate": "npm --workspace apps/backend run prisma:generate",
    "db:migrate": "npm --workspace apps/backend run prisma:migrate",
    "db:seed": "npm --workspace apps/backend run prisma:seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
